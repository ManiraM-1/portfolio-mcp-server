SPRING_AI_GOOGLE_GENAI_API_KEY=your_gemini_api_key
SPRING_AI_GOOGLE_GENAI_EMBEDDING_API_KEY=your_gemini_api_key
# Use the Supabase Session Pooler connection, not the direct connection —
# the direct-connection host is IPv6-only and will not connect from Docker
# containers or Hugging Face Spaces (both IPv4-only networks).
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.your_project_ref
SPRING_DATASOURCE_PASSWORD=your_supabase_password
